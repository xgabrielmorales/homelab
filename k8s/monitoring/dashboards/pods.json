{
  "uid": "pod-metrics-logs",
  "title": "Pods / Metrics & Logs",
  "tags": [
    "kubernetes"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "current": {}
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "sort": 1,
        "current": {}
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "$pod",
      "repeat": "pod",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "CPU (cores) — $pod",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 1
          },
          "fieldConfig": {
            "defaults": {
              "unit": "none"
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=\"$pod\", container!=\"\"}[5m]))",
              "legendFormat": "{{container}}"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Memory (working set) — $pod",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 8,
            "y": 1
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})",
              "legendFormat": "{{container}}"
            },
            {
              "expr": "sum(kube_pod_container_resource_limits{namespace=\"$namespace\", pod=\"$pod\", resource=\"memory\"})",
              "legendFormat": "limit"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Network / Restarts — $pod",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 16,
            "y": 1
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps"
            },
            "overrides": []
          },
          "targets": [
            {
              "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\", pod=\"$pod\"}[5m]))",
              "legendFormat": "rx"
            },
            {
              "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\", pod=\"$pod\"}[5m]))",
              "legendFormat": "tx"
            },
            {
              "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=\"$pod\"})",
              "legendFormat": "restarts"
            }
          ]
        },
        {
          "type": "logs",
          "title": "Logs — $pod",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 8
          },
          "options": {
            "showTime": true,
            "wrapLogMessage": false,
            "sortOrder": "Descending",
            "enableLogDetails": true
          },
          "targets": [
            {
              "expr": "{namespace=\"$namespace\", pod=\"$pod\"}",
              "queryType": "range"
            }
          ]
        }
      ]
    }
  ]
}
