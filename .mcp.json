{
  "mcpServers": {
    "grafana": {
      "type": "stdio",
      "command": "nix",
      "args": [
        "shell",
        "nixpkgs#uv",
        "-c",
        "uvx",
        "mcp-grafana",
        "--enabled-tools",
        "search,datasource,prometheus,loki,tempo,alerting,dashboard,folder,annotations,navigation,api,config,docs"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.xgabrielmorales.com",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    }
  }
}
